        <mxCell id="53" value="A half-filled run is saved and answered with 200 and ready = false: saving a draft never fails because the user is not finished." style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="40" y="1470" width="1480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="54" value="One save is in flight; later changes wait and go out as one PATCH. One ETag guards the whole run. Every field is a column of Run." style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
