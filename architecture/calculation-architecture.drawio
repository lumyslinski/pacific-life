        <mxCell id="40" value="The SQL model transaction never waits&#10;for the optional DynamoDB projection." style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#24795C;" vertex="1" parent="1">
          <mxGeometry x="75" y="1052" width="590" height="80" as="geometry" />
        </mxCell>
        <mxCell id="41" value="Failure or crash before the delivery flag:&#10;leave pending and retry. Identical duplicate writes&#10;are accepted; conflicting content raises an error." style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="750" y="1060" width="630" height="105" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Calculation audit: before/after values, bindings, arguments, objective and query IDs. Emulator query history also records failed queries." style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="40" y="1170" width="1360" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
