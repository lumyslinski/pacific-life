        <mxCell id="17" value="Read exact revision; verify canonical hash" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#24795C;" vertex="1" parent="1">
          <mxGeometry x="922" y="421" width="450" height="30" as="geometry" />
