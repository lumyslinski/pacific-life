        <mxCell id="18" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#356CC9;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="19" value="1 · Vue → Litestar command API&#10;POST /runs with requestId&#10;Core: retained Bronze reference&#10;Regional: scenario + expectedRevision&#10;Receipt check before selecting latest&#10;202 + runId + Location after commit" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="72" y="535" width="396" height="190" as="geometry" />
        </mxCell>
        <mxCell id="20" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#24795C;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="525" width="520" height="210" as="geometry" />
        </mxCell>
        <mxCell id="21" value="2 · Accept atomically in Snowflake&#10;Python freezes input + plan + planHash&#10;RUNS = QUEUED + command receipt&#10;RUN_OUTBOX = pending dispatch&#10;Contract/source/scenario revisions pinned&#10;No direct API-to-queue dual write" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="632" y="535" width="496" height="190" as="geometry" />
        </mxCell>
        <mxCell id="22" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#356CC9;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1280" y="525" width="460" height="210" as="geometry" />
        </mxCell>
        <mxCell id="23" value="3 · Run relay → SQS FIFO&#10;Read pending RUN_OUTBOX&#10;Send runId + dispatchId + generation&#10;Group = scenarioId (core: bronzeId)&#10;Deduplication ID = dispatchId&#10;Mark delivered only after send ACK" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="1292" y="535" width="436" height="190" as="geometry" />
        </mxCell>
        <mxCell id="24" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#356CC9;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="625" as="sourcePoint" />
            <mxPoint x="620" y="625" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="25" value="Accept" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#356CC9;" vertex="1" parent="1">
          <mxGeometry x="485" y="580" width="130" height="32" as="geometry" />
