        <mxCell id="36" value="Failure publishes no Gold result.&#10;Persist attempt errors; retain history.&#10;Guard result pointer by draft + run.&#10;New settings need a new draft/run." style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
