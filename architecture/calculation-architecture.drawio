        <mxCell id="32" value="DeathPenatly example&#10;Immutable core amount: 800&#10;First user edit: 700 → result 630&#10;Next user edit: 600 → result 540&#10;Regional rule: reduce by 10%" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
