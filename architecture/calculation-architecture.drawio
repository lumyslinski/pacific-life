        <mxCell id="25" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#356CC9;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="765" width="500" height="295" as="geometry" />
        </mxCell>
        <mxCell id="26" value="PYTHON CALCULATION WORKER&#10;Separate container running on AWS Fargate&#10;&#10;1. Receive a request from the Amazon queue&#10;2. Load its fixed model and rules&#10;3. Use CalculationWorker.run() to call Snowflake&#10;4. Save the result or failure and finish the job" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="552" y="775" width="476" height="275" as="geometry" />
        </mxCell>
        <mxCell id="27" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#E8F4EB;strokeColor=#24795C;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1180" y="765" width="450" height="295" as="geometry" />
        </mxCell>
        <mxCell id="28" value="SNOWFLAKE · CALCULATES THE VALUE&#10;Input: { DeathPenatly: 700 }&#10;&#10;Regional rule: reduce the amount by 10%&#10;700 × 0.90 = 630&#10;&#10;Return 630, or a calculation error" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
