        <mxCell id="24" value="The screen follows progress&#10;Waiting → Calculating&#10;Automatically checks saved status&#10;Closing the browser does not&#10;stop the background calculation&#10;Return later to see the outcome" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=19;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
