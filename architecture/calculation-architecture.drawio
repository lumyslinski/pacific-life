        <mxCell id="15" value="Publish" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#24795C;" vertex="1" parent="1">
