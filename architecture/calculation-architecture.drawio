        <mxCell id="26" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#356CC9;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="625" as="sourcePoint" />
            <mxPoint x="1280" y="625" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="27" value="Relay polls" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#356CC9;" vertex="1" parent="1">
          <mxGeometry x="1145" y="580" width="130" height="32" as="geometry" />
        </mxCell>
        <mxCell id="28" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#356CC9;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1280" y="890" width="460" height="225" as="geometry" />
        </mxCell>
        <mxCell id="29" value="4 · Separate ECS Fargate worker&#10;Conditional claim + fenced lease&#10;Commit RUN_ATTEMPTS start record&#10;Load frozen plan; verify planHash&#10;Heartbeat lease + extend SQS visibility&#10;Synchronous batched SQL functions&#10;Delete queue message after result commit" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="1292" y="900" width="436" height="205" as="geometry" />
        </mxCell>
        <mxCell id="30" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#356CC9;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1510" y="735" as="sourcePoint" />
            <mxPoint x="1510" y="890" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="31" value="Receive dispatch" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#356CC9;" vertex="1" parent="1">
          <mxGeometry x="1315" y="797" width="390" height="32" as="geometry" />
        </mxCell>
        <mxCell id="32" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#24795C;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="890" width="520" height="225" as="geometry" />
        </mxCell>
        <mxCell id="33" value="5 · Atomic result transaction in Snowflake&#10;Recheck run owner / fencing token / lease&#10;Complete Silver or Gold + lineage + traces&#10;AUDIT_EVENTS + AUDIT_OUTBOX&#10;RUN_EVENT_OUTBOX + attempt success&#10;RUNS = SUCCEEDED + result reference&#10;Guard scenario pointer by draft + selected run" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="632" y="900" width="496" height="205" as="geometry" />
        </mxCell>
        <mxCell id="34" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#24795C;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1280" y="1000" as="sourcePoint" />
            <mxPoint x="1140" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="35" value="Commit" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#24795C;" vertex="1" parent="1">
          <mxGeometry x="1145" y="955" width="130" height="32" as="geometry" />
        </mxCell>
        <mxCell id="36" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#356CC9;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="420" height="225" as="geometry" />
        </mxCell>
        <mxCell id="37" value="6 · Vue listens through persisted state&#10;GET /runs/{runId}&#10;ETag / If-None-Match polling&#10;SSE can be added later&#10;Success → immutable result reference&#10;Failure → diagnostics + retry eligibility&#10;Review Gold; finish, edit or chain" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="72" y="900" width="396" height="205" as="geometry" />
        </mxCell>
        <mxCell id="38" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#24795C;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="1000" as="sourcePoint" />
            <mxPoint x="480" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="39" value="Via API" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#24795C;" vertex="1" parent="1">
          <mxGeometry x="485" y="955" width="130" height="32" as="geometry" />
        </mxCell>
        <mxCell id="40" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#356CC9;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="890" as="sourcePoint" />
            <mxPoint x="270" y="735" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="41" value="New draft → new run; retry → same plan" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="75" y="791" width="390" height="35" as="geometry" />
        </mxCell>
        <mxCell id="42" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#A96915;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1280" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="43" value="Failure and recovery&#10;Rollback: no partial Silver or Gold&#10;Persist attempt error and retry budget&#10;RETRYABLE → redelivery / backoff&#10;Expired lease → fence + recovery dispatch&#10;DLQ reconciler → terminal FAILED&#10;Manual retry → new dispatch generation&#10;Old generations cannot claim or publish" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="72" y="1290" width="396" height="220" as="geometry" />
        </mxCell>
        <mxCell id="44" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#A96915;strokeWidth=1.7;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="1280" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="45" value="Independent downstream outboxes&#10;AUDIT_OUTBOX → audit-export → PostgreSQL&#10;Existing direct copy; one row per event id&#10;&#10;RUN_EVENT_OUTBOX → relay → EventBridge&#10;Proposed RunCompleted + result reference&#10;ACK each successful entry; retry failures&#10;Consumers deduplicate by stable event ID" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="632" y="1290" width="496" height="220" as="geometry" />
        </mxCell>
        <mxCell id="46" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#A96915;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="1115" as="sourcePoint" />
            <mxPoint x="880" y="1280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="47" value="Read only committed events" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#A96915;" vertex="1" parent="1">
          <mxGeometry x="665" y="1175" width="430" height="32" as="geometry" />
        </mxCell>
        <mxCell id="48" value="" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;rounded=0;fillColor=#FFFFFF;strokeColor=#738096;strokeWidth=1.7;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1280" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="49" value="Stage 2 · when multi-step state is needed&#10;Step Functions Standard OR Temporal&#10;Core → human wait → custom fan-out&#10;Explicit chaining from delivered Gold&#10;Activities call the same idempotent run API&#10;Server-side callback / workflow state&#10;Choose one retry owner per layer&#10;No engine is deployed in this package" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="1292" y="1290" width="436" height="220" as="geometry" />
        </mxCell>
        <mxCell id="50" value="FIFO deduplication lasts five minutes. Relay retries reuse dispatchId; deliberate retry/recovery uses a new dispatchId and generation." style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#172B46;" vertex="1" parent="1">
          <mxGeometry x="55" y="1570" width="1690" height="38" as="geometry" />
        </mxCell>
