        <mxCell id="7" value="Authoring: Vue admin or optional Git CI&#10;PUT /contracts/{id}&#10;POST /contracts/{id}/publish&#10;CONTRACT_DRAFTS + expectedRevision&#10;Mutable authoring; exact revision to publish" style="html=0;fontFamily=Arial;fontColor=#172B46;labelBackgroundColor=#FFFFFF;labelBorderColor=none;text;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#172B46;" vertex="1" parent="1">
