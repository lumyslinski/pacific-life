# Shell and SQL files must keep LF endings on Windows checkouts: bash and psql
# in the postgres image do not accept CRLF, and generated files are compared byte for byte.
*.sh    text eol=lf
*.sql   text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.ts    text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
