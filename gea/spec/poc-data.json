    {"prop": "region", "displayName": "Region", "step": "main", "type": "string", "control": "select", "required": true, "column": "RegionId", "lookup": "Region", "options": [["australia", "Australia"], ["asia", "Asia"], ["europe", "Europe"], ["north-america", "North America"], ["global", "Global"]]},
    {"prop": "businessPurpose", "displayName": "Business purpose", "step": "main", "type": "string", "control": "select", "required": true, "column": "BusinessPurposeId", "lookup": "BusinessPurpose", "options": [["rnd", "R&D"], ["pricing", "Pricing"]]},
    {"prop": "benefit", "displayName": "Benefit", "step": "main", "type": "array<string>", "control": "multiselect", "required": true, "table": "ProjectBenefit", "lookup": "Benefit", "options": [["mortality", "Mortality"], ["morbidity", "Morbidity"], ["lapse-persistency", "Lapse / Persistency"], ["longevity", "Longevity"], ["all-mixed", "All / Mixed"]]}
  ],
  "createRun": [
    {"prop": "name", "displayName": "Run name", "step": "main", "type": "string", "control": "text input", "required": true, "column": "Name"},
