    {"prop": "additionalOutputFields", "displayName": "Additional Output Fields", "step": "actualExpected", "type": "array<string>", "control": "multiselect", "required": false, "column": "AdditionalOutputFields", "options": [["PolicyYear", "PolicyYear"], ["IssueAge", "IssueAge"]]}
