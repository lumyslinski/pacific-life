{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gea.plre.example/schemas/data-contract/1.0.json",
  "$comment": "GENERATED by gea/tools/generate.py - do not edit by hand.",
  "title": "GEA run data contract",
  "description": "Immutable, versioned snapshot of one run configuration. Stored in PostgreSQL (gea.\"DataContract\") and delivered unchanged to Snowflake, which executes `steps` in order. The props are those of workbook sheet 'POC Data'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "contractId",
    "version",
    "projectId",
    "runId",
    "createdAt",
    "createdBy",
    "project",
    "run",
    "steps"
  ],
  "properties": {
    "specVersion": {
      "const": "1.0"
    },
    "contractId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Contract version within the run."
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "region",
        "businessPurpose",
        "benefit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "enum": [
            "australia",
            "asia",
            "europe",
            "north-america",
            "global"
          ]
        },
        "businessPurpose": {
          "enum": [
            "rnd",
            "pricing"
          ]
        },
        "benefit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mortality",
              "morbidity",
              "lapse-persistency",
              "longevity",
              "all-mixed"
            ]
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "treaty"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "treaty": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "ordinal",
            "config"
          ],
          "properties": {
            "key": {
              "const": "dataAndSetUp"
            },
            "ordinal": {
              "const": 1
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dataScope",
                "studyPeriod",
                "studyPeriodTreatyOverride",
                "investigation"
              ],
              "properties": {
                "dataScope": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "title": "Data Scope",
                  "minItems": 1
                },
                "studyPeriod": {
                  "$ref": "#/$defs/DateRange"
                },
                "studyPeriodExclusions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/DateRange"
                  },
                  "title": "Study Period Exclusions",
                  "minItems": 1
                },
                "studyPeriodTreatyOverride": {
                  "type": "boolean",
                  "title": "Study Period Treaty Override"
                },
                "perTreatyEndDatesMapping": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Per Treaty End Dates Mapping"
                },
                "investigation": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Investigation"
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "studyPeriodTreatyOverride"
                    ],
                    "properties": {
                      "studyPeriodTreatyOverride": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "perTreatyEndDatesMapping"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "ordinal",
            "config"
          ],
          "properties": {
            "key": {
              "const": "segmentation"
            },
            "ordinal": {
              "const": 2
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "exposureMethod",
                "initialExposureMethod"
              ],
              "properties": {
                "exposureMethod": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Exposure Method"
                },
                "initialExposureMethod": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Initial - Exposure Method"
                },
                "exposureExclusion": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "title": "Exposure Exclusion",
                  "minItems": 1
                },
                "policyTenureSegmentation": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Policy Tenure Segmentation"
                },
                "calendarTenureSegmentation": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Calendar Tenure Segmentation"
                },
                "attainedAgeSegmentation": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Attained-Age Segmentation"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "ordinal",
            "config"
          ],
          "properties": {
            "key": {
              "const": "actuals"
            },
            "ordinal": {
              "const": 3
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "partialClaimTreatment",
                "amountBasis"
              ],
              "properties": {
                "partialClaimTreatment": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Partial Claim Treatment"
                },
                "amountBasis": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Amount Basis"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "ordinal",
            "config"
          ],
          "properties": {
            "key": {
              "const": "ibnr"
            },
            "ordinal": {
              "const": 4
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claimBasis",
                "ibnrMethodology",
                "derivationMethod",
                "ibnrStudyPeriod",
                "developmentFrequency",
                "upliftFrequency",
                "ibnrRbnsBasis"
              ],
              "properties": {
                "claimBasis": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Claim Basis"
                },
                "ibnrMethodology": {
                  "type": "string",
                  "minLength": 1,
                  "title": "IBNR Methodology"
                },
                "derivationMethod": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Derivation Method"
                },
                "ibnrStudyPeriod": {
                  "$ref": "#/$defs/DateRange"
                },
                "developmentFrequency": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Development Frequency"
                },
                "upliftFrequency": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Uplift Frequency"
                },
                "eventMonthFilter": {
                  "type": "boolean",
                  "title": "Event Month Filter"
                },
                "reportingMonthFilter": {
                  "type": "boolean",
                  "title": "Reporting Month Filter"
                },
                "ibnrRbnsBasis": {
                  "type": "string",
                  "minLength": 1,
                  "title": "IBNR / RBNS Basis"
                },
                "tailStartPeriod": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Tail Start Period"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "ordinal",
            "config"
          ],
          "properties": {
            "key": {
              "const": "assigningExpected"
            },
            "ordinal": {
              "const": 5
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "comparisonBases": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Comparison Bases"
                },
                "trendAssumptions": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Trend Assumptions"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "ordinal",
            "config"
          ],
          "properties": {
            "key": {
              "const": "ultimateCalculation"
            },
            "ordinal": {
              "const": 6
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "adjustment",
                "ultimateRbnsBasis"
              ],
              "properties": {
                "adjustment": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Adjustment"
                },
                "ultimateRbnsBasis": {
                  "type": "string",
                  "minLength": 1,
                  "title": "RBNS Basis"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "ordinal",
            "config"
          ],
          "properties": {
            "key": {
              "const": "actualExpected"
            },
            "ordinal": {
              "const": 7
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outputFrequency"
              ],
              "properties": {
                "outputFrequency": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "title": "Output Frequency",
                  "minItems": 1
                },
                "additionalOutputFields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "title": "Additional Output Fields",
                  "minItems": 1
                }
              }
            }
          }
        }
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    }
  },
  "$defs": {
    "DateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
